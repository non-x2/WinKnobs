<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- アプリ情報 -->
    <AssemblyTitle>WinKnobs</AssemblyTitle>
    <AssemblyDescription>Modern Windows 11 tweaking tool inspired by Ijikuru Tool</AssemblyDescription>
    <AssemblyCompany>のんラボ</AssemblyCompany>
    <AssemblyProduct>WinKnobs</AssemblyProduct>
    <Authors>nonlabo</Authors>
    <Copyright>Copyright (c) 2026 のんラボ</Copyright>
    <AssemblyVersion>0.4.14.0</AssemblyVersion>
    <FileVersion>0.4.14.0</FileVersion>
    <Version>0.4.14</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/non-x2/WinKnobs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/non-x2/WinKnobs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- マニフェスト（HiDPI・UAC設定） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <!-- 配布物に作成PCのフォルダ名・ユーザー名を埋め込まない（2026-10-22 配布物の鍵点検で v0.4.9 に検出） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
  </ItemGroup>

</Project>
