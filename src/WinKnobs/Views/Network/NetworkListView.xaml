<UserControl x:Class="WinKnobs.Views.Network.NetworkListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKnobs.ViewModels.Network"
             d:DataContext="{d:DesignInstance Type=vm:NetworkListViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Fg.Default}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,12">

            <!-- 今の状態（Phase 3/4 で実値表示） -->
            <Border Padding="10,8" Margin="0,0,0,12"
                    Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="今の状態" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock AutomationProperties.AutomationId="NetworkDnsSummary"
                               Text="{Binding DnsSummary, StringFormat=DNS：{0}}"
                               Foreground="{DynamicResource Fg.Subtle}" Margin="0,1"/>
                    <TextBlock Text="{Binding ConnectionSummary, StringFormat=通信：{0}}"
                               Foreground="{DynamicResource Fg.Subtle}" Margin="0,1"/>
                    <TextBlock Text="{Binding DeliveryOptimizationSummary, StringFormat=配信最適化(P2P)：{0}}"
                               Foreground="{DynamicResource Fg.Subtle}" Margin="0,1"/>
                </StackPanel>
            </Border>

            <!-- かんたん設定（おすすめ）：Phase 3-6 で実装 -->
            <TextBlock Text="━━ かんたん設定（おすすめ）━━" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Margin="0,0,0,12">
                <Button AutomationProperties.AutomationId="NetworkBandwidthButton"
                        Command="{Binding SetBandwidthCommand}"
                        HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,5" Padding="8,5"
                        HorizontalContentAlignment="Left"
                        Content="🚀 通信を軽くする　— 余計な自動通信を抑える"/>
                <Button AutomationProperties.AutomationId="NetworkDnsButton"
                        Command="{Binding ApplyDnsCommand}" CommandParameter="cloudflare"
                        HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,5" Padding="8,5"
                        HorizontalContentAlignment="Left"
                        Content="🌐 DNSを速くする　— Cloudflare に変更"/>
                <Button AutomationProperties.AutomationId="NetworkResetButton"
                        Command="{Binding ResetNetworkCommand}"
                        HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,5" Padding="8,5"
                        HorizontalContentAlignment="Left"
                        Content="🔧 不調を直す　— DNSキャッシュをクリア"/>
            </StackPanel>

            <!-- Windowsの画面を開く（機能0・実装済・開くだけ） -->
            <TextBlock Text="━━ Windowsの画面を開く ━━" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,12">
                <Button AutomationProperties.AutomationId="NetworkOpenStatusButton"
                        Command="{Binding OpenWindowsNetworkCommand}" CommandParameter="status"
                        Content="🪟 ネットの状態" MinWidth="120" Margin="0,0,6,6" Padding="8,5"/>
                <Button AutomationProperties.AutomationId="NetworkOpenWifiButton"
                        Command="{Binding OpenWindowsNetworkCommand}" CommandParameter="wifi"
                        Content="📶 Wi-Fi" MinWidth="100" Margin="0,0,6,6" Padding="8,5"/>
                <Button AutomationProperties.AutomationId="NetworkOpenAdaptersButton"
                        Command="{Binding OpenWindowsNetworkCommand}" CommandParameter="adapters"
                        Content="🔌 アダプター" MinWidth="120" Margin="0,0,6,6" Padding="8,5"/>
                <Button AutomationProperties.AutomationId="NetworkOpenSharingButton"
                        Command="{Binding OpenWindowsNetworkCommand}" CommandParameter="sharing"
                        Content="🌍 共有センター" MinWidth="130" Margin="0,0,6,6" Padding="8,5"/>
            </WrapPanel>

            <!-- 安心：ぜんぶ元に戻す（Phase 5 で実装） -->
            <TextBlock Text="━━ 安心 ━━" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Button AutomationProperties.AutomationId="NetworkRevertAllButton"
                    Command="{Binding RevertAllCommand}"
                    HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,4" Padding="8,5"
                    HorizontalContentAlignment="Left"
                    Content="↩ ぜんぶ元の状態に戻す　（変更前に自動退避）"/>
            <TextBlock Text="※ DNS・通信設定の変更は自動で退避され、ここから戻せます（ネットワークのリセットは戻せません）。"
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource Fg.Subtle}" Margin="0,0,0,12"/>

            <!-- ▸ くわしい設定（上級者向け・既定折りたたみ）。既存ネットワーク詳細項目を表示 -->
            <Expander AutomationProperties.AutomationId="NetworkAdvancedExpander"
                      Header="くわしい設定（上級者向け）"
                      IsExpanded="{Binding IsAdvancedExpanded}">
                <StackPanel Margin="4,8,0,0">
                    <!-- DNS の選び方（Cloudflare はかんたん設定にも・ここでは Google / 自動 も選べる） -->
                    <TextBlock Text="DNS の選び方" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button AutomationProperties.AutomationId="NetworkDnsCloudflareButton"
                                Command="{Binding ApplyDnsCommand}" CommandParameter="cloudflare"
                                Content="Cloudflare (1.1.1.1)" MinWidth="150" Margin="0,0,6,6" Padding="8,4"/>
                        <Button AutomationProperties.AutomationId="NetworkDnsGoogleButton"
                                Command="{Binding ApplyDnsCommand}" CommandParameter="google"
                                Content="Google (8.8.8.8)" MinWidth="140" Margin="0,0,6,6" Padding="8,4"/>
                        <Button AutomationProperties.AutomationId="NetworkDnsAutoButton"
                                Command="{Binding ApplyDnsCommand}" CommandParameter="auto"
                                Content="自動 (DHCP) に戻す" MinWidth="150" Margin="0,0,6,6" Padding="8,4"/>
                    </WrapPanel>
                    <!-- 対象アダプタ選択（Phase 7c・既定全チェック＝従来の全件挙動） -->
                    <TextBlock Text="対象アダプタ（チェックしたアダプタにだけ上の DNS・手入力を適用）"
                               TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,4"/>
                    <ItemsControl AutomationProperties.AutomationId="NetworkAdapterList"
                                  ItemsSource="{Binding Adapters}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          AutomationProperties.AutomationId="{Binding Id, StringFormat=NetworkAdapterCheck_{0}}"
                                          Margin="0,2" VerticalContentAlignment="Center">
                                    <CheckBox.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{DynamicResource Fg.Subtle}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox.Content>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- DNS 手入力（Phase 7a・DialogService にテキスト入力が無いためインライン TextBox） -->
                    <TextBlock Text="DNS を手入力（任意のサーバを指定）" FontWeight="SemiBold" Margin="0,2,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="優先 (IPv4)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 AutomationProperties.AutomationId="NetworkDnsCustomV4Primary"
                                 Text="{Binding CustomDnsV4Primary, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4" Padding="4,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="代替 (IPv4)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 AutomationProperties.AutomationId="NetworkDnsCustomV4Secondary"
                                 Text="{Binding CustomDnsV4Secondary, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4" Padding="4,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="IPv6 (任意)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 AutomationProperties.AutomationId="NetworkDnsCustomV6"
                                 Text="{Binding CustomDnsV6, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4" Padding="4,2"/>
                    </Grid>
                    <Button AutomationProperties.AutomationId="NetworkDnsCustomApplyButton"
                            Command="{Binding ApplyCustomDnsCommand}"
                            HorizontalAlignment="Left" MinWidth="200" Margin="0,0,0,10" Padding="8,4"
                            Content="この内容で適用"/>

                    <TextBlock Text="（DoH ON/OFF は今後追加予定）"
                               FontSize="11" Foreground="{DynamicResource Fg.Subtle}" Margin="0,0,0,10"/>

                    <TextBlock Text="ネットワークの詳細項目（ダブルクリックで編集）"
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Fg.Subtle}" Margin="0,0,0,6"/>
                    <!-- 既存 Network 項目（HTTP同時接続数 / TCP Auto-Tuning）を MainViewModel の独立ビューから表示。
                         本ペインの DataContext は NetworkListViewModel のため、Window 経由で MainViewModel に到達する。 -->
                    <DataGrid x:Name="NetworkAdvancedGrid"
                              AutomationProperties.AutomationId="NetworkAdvancedGrid"
                              ItemsSource="{Binding DataContext.NetworkAdvancedItems, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=Window}}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              RowHeight="30" CanUserResizeRows="False" SelectionMode="Single"
                              MaxHeight="220" BorderThickness="0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="AutomationProperties.AutomationId"
                                        Value="{Binding Id, StringFormat=NetworkItem_{0}}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding RiskMark}" Width="32" FontSize="14"/>
                            <DataGridTextColumn Header="項目" Binding="{Binding Title}" Width="240"/>
                            <DataGridTextColumn Header="説明" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="再起動" Binding="{Binding RestartMark}" Width="60"/>
                        </DataGrid.Columns>
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding DataContext.OpenSelectedItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </DataGrid.InputBindings>
                    </DataGrid>
                </StackPanel>
            </Expander>

            <!-- ステータス -->
            <Border Margin="0,12,0,0" Padding="8,5"
                    Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="NetworkStatusText"
                           AutomationProperties.AutomationId="NetworkStatusText"
                           Text="{Binding StatusMessage}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg.Subtle}"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
