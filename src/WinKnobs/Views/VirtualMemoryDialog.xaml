<Window x:Class="WinKnobs.Views.VirtualMemoryDialog"
        x:Name="VirtualMemoryDialogRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinKnobs.ViewModels"
        xmlns:conv="clr-namespace:WinKnobs.Converters"
        d:DataContext="{d:DesignInstance Type=vm:VirtualMemoryViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="仮想メモリ（ページファイル）設定（要管理者・再起動）"
        AutomationProperties.AutomationId="VirtualMemoryDialog"
        Height="660" Width="660"
        MinHeight="560" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Fg.Default}">

    <Window.Resources>
        <conv:BoolToVisibleVisibilityConverter x:Key="BoolToVisible"/>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="0">

        <!-- ヘッダ：🔴 危険度バッジ -->
        <Border DockPanel.Dock="Top"
                Background="#33FF5252"
                BorderBrush="#FFE57373"
                BorderThickness="0,0,0,2"
                Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔴" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding HeaderText}"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#FFD32F2F" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="危険度：高" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Margin="28,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Text="{Binding WhatHappensText}"/>
            </StackPanel>
        </Border>

        <!-- フッタ：理解チェック + 適用/キャンセル -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel>
                <CheckBox x:Name="CheckUnderstandVmRisk"
                          Content="リスクを理解しました（再起動で反映・元に戻せます）"
                          IsChecked="{Binding IsRiskUnderstood}"
                          AutomationProperties.AutomationId="CheckUnderstandVmRisk"
                          FontWeight="Bold"
                          Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnVmApply"
                            Content="適用（再起動で反映）"
                            Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding CanApply}"
                            AutomationProperties.AutomationId="BtnVmApply"
                            MinWidth="150" Margin="0,0,8,0" Padding="10,5"/>
                    <Button x:Name="BtnVmCancel"
                            Content="キャンセル"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            AutomationProperties.AutomationId="BtnVmCancel"
                            MinWidth="100" Padding="10,5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 本体 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>

                <!-- 現在の状態 -->
                <TextBlock Text="現在の状態" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="3" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock Text="{Binding CurrentStateText}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="VmCurrentStateText"/>
                </Border>

                <!-- 設定方法 -->
                <TextBlock Text="設定方法" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel Margin="0,0,0,8">
                    <RadioButton GroupName="VmMode"
                                 AutomationProperties.AutomationId="VmModeAuto"
                                 IsChecked="{Binding IsAutoMode}"
                                 Content="自動管理（Windows に任せる）— 推奨・安全"
                                 Margin="0,2"/>
                    <RadioButton GroupName="VmMode"
                                 AutomationProperties.AutomationId="VmModeSystem"
                                 IsChecked="{Binding IsSystemMode}"
                                 Content="システム管理サイズ（自動管理を切ってサイズは Windows 任せ）"
                                 Margin="0,2"/>
                    <RadioButton GroupName="VmMode"
                                 AutomationProperties.AutomationId="VmModeManual"
                                 IsChecked="{Binding IsManualMode}"
                                 Content="手動（サイズを自分で指定）"
                                 Margin="0,2"/>
                </StackPanel>

                <!-- 手動サイズ（手動モードのみ表示） -->
                <Border Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVisible}}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="3" Padding="10,8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="C: ドライブのページファイル サイズ（MB）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="初期サイズ" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1"
                                     AutomationProperties.AutomationId="VmInitialSize"
                                     Text="{Binding InitialSizeText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,2" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="最大サイズ" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3"
                                     AutomationProperties.AutomationId="VmMaxSize"
                                     Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,2"/>
                        </Grid>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   AutomationProperties.AutomationId="VmValidationMessage"
                                   Foreground="#FFE57373" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 警告 -->
                <Border Background="#33FFD54F" BorderBrush="#FFFFB300" BorderThickness="1"
                        CornerRadius="3" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="VmWarningText"/>
                </Border>

                <!-- 戻し方の保証 -->
                <Border Background="#3366BB6A" BorderBrush="#FF81C784" BorderThickness="1"
                        CornerRadius="3" Padding="10,8">
                    <TextBlock Text="{Binding RestoreAssuranceText}" TextWrapping="Wrap"/>
                </Border>

                <!-- 安全弁：純正設定へ逃がす（判断の場で・U-1） -->
                <Button AutomationProperties.AutomationId="OpenWindowsVirtualMemoryButton"
                        Command="{Binding OpenNativeSettingsCommand}"
                        Content="🪟 Windows 純正の設定を開く（詳細設定 → 仮想メモリ）"
                        HorizontalAlignment="Left" Margin="0,12,0,0" Padding="8,5"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
