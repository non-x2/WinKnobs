<UserControl x:Class="WinKnobs.Views.Startup.StartupListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKnobs.ViewModels.Startup"
             d:DataContext="{d:DesignInstance Type=vm:StartupListViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Fg.Default}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ注記（plan-validator #3：Run キーのみ対象であることを明示） -->
        <Border Grid.Row="0"
                Padding="8,6"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,0,0,1">
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Fg.Subtle}">
                <Run Text="ⓘ"/>
                <Run Text=" Run キー（レジストリ）のみ対象です。タスクスケジューラ・スタートアップフォルダ（shell:startup）はこのツールでは表示・編集できません（タスクマネージャーで操作してください）。"/>
            </TextBlock>
        </Border>

        <!-- ツールバー（Phase R-2：編集・保存。追加・削除は R-3 で実装予定） -->
        <Border Grid.Row="1"
                Padding="8,4"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartupAddButton"
                        AutomationProperties.AutomationId="StartupAddButton"
                        Content="+ 追加"
                        IsEnabled="False"
                        ToolTip="Phase R-3 で実装予定"
                        MinWidth="80" Margin="0,0,6,0" Padding="6,3"/>
                <Button x:Name="StartupEditButton"
                        AutomationProperties.AutomationId="StartupEditButton"
                        Content="✏ 編集"
                        Command="{Binding EditCommand}"
                        ToolTip="選択中のエントリの起動コマンドを編集します"
                        MinWidth="80" Margin="0,0,6,0" Padding="6,3"/>
                <Button x:Name="StartupDeleteButton"
                        AutomationProperties.AutomationId="StartupDeleteButton"
                        Content="🗑 削除"
                        IsEnabled="False"
                        ToolTip="Phase R-3 で実装予定"
                        MinWidth="80" Margin="0,0,6,0" Padding="6,3"/>
                <Button x:Name="StartupSaveButton"
                        AutomationProperties.AutomationId="StartupSaveButton"
                        Content="💾 保存"
                        Command="{Binding SaveDirtyCommand}"
                        IsEnabled="{Binding HasDirtyEntries}"
                        ToolTip="編集中のエントリをレジストリに書込みます（HKLM 系は管理者権限要）"
                        MinWidth="80" Margin="0,0,6,0" Padding="6,3"/>
                <Button x:Name="StartupRevertButton"
                        AutomationProperties.AutomationId="StartupRevertButton"
                        Content="↺ 戻す"
                        Command="{Binding RevertAllCommand}"
                        IsEnabled="{Binding HasDirtyEntries}"
                        ToolTip="編集中の変更を破棄して元の値に戻します（レジストリは触らない・R-3 でバックアップ復元と差別化）"
                        MinWidth="80" Margin="0,0,6,0" Padding="6,3"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg.Default}"
                           Text="⚠ 操作モード：CheckBox は即時反映 ／ ✏編集 は 💾保存 で永続化（2モード混在）"/>
            </StackPanel>
        </Border>

        <!-- メインリスト -->
        <DataGrid Grid.Row="2"
                  x:Name="StartupItemsGrid"
                  AutomationProperties.AutomationId="StartupItemsGrid"
                  ItemsSource="{Binding FilteredEntries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="28"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  BorderThickness="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="AutomationProperties.AutomationId"
                            Value="{Binding RawName, StringFormat=StartupEntry_{0}}"/>
                    <Style.Triggers>
                        <!-- 編集中（IsDirty=true）→ 薄オレンジ背景で視認性向上（既存 SettingDialog のオレンジ枠と同系統） -->
                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                            <Setter Property="Background" Value="#33FF9933"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- 有効/無効 CheckBox（R-2 即時トグル：クリックで ToggleEnabledCommand 即発火） -->
                <!-- R-2 cross#7/#16 対応：列ヘッダに「即時」明示・CanToggleEnabled で RunOnce/IsDirty 中は disable -->
                <DataGridTemplateColumn Header="有効（即時）" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox AutomationProperties.AutomationId="StartupEnabledCheckBox"
                                      IsChecked="{Binding IsEnabledForDisplay, Mode=OneWay}"
                                      IsEnabled="{Binding CanToggleEnabled}"
                                      Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      HorizontalAlignment="Center"
                                      ToolTip="{Binding CheckBoxTooltip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="" Binding="{Binding RiskMark}" Width="32" FontSize="14"/>
                <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="コマンド" Binding="{Binding Command}" Width="*"/>
                <DataGridTextColumn Header="ハイブ" Binding="{Binding HiveDisplay}" Width="140"/>
            </DataGrid.Columns>
            <!-- ダブルクリックで編集ダイアログ起動（既存 ItemsGrid と同じ UX） -->
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding EditCommand}"/>
            </DataGrid.InputBindings>
        </DataGrid>

        <!-- ステータス -->
        <Border Grid.Row="3"
                Padding="8,4"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StartupStatusText"
                       AutomationProperties.AutomationId="StartupStatusText"
                       Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource Fg.Subtle}"/>
        </Border>
    </Grid>
</UserControl>
