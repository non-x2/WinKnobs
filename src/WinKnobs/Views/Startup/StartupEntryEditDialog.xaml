<Window x:Class="WinKnobs.Views.Startup.StartupEntryEditDialog"
        x:Name="StartupEntryEditDialogRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinKnobs.ViewModels.Startup"
        d:DataContext="{d:DesignInstance Type=vm:StartupEntryEditViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="スタートアップエントリの編集"
        AutomationProperties.AutomationId="StartupEntryEditDialog"
        Height="320" Width="620"
        MinHeight="280" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Fg.Default}">

    <DockPanel LastChildFill="True" Margin="0">

        <!-- ヘッダ：エントリ名＋ハイブ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚀" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EntryNameText"
                               AutomationProperties.AutomationId="EntryNameText"
                               Text="{Binding DisplayName}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg.Default}"/>
                </StackPanel>
                <TextBlock Text="{Binding HiveDisplay}"
                           Margin="26,4,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource Fg.Muted}"/>
                <TextBlock Text="※ Name 変更は R-3 で対応予定です（現在は Command と種別のみ編集可能）。"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource Fg.Subtle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- フッタ：OK／キャンセル -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartupEditOkButton"
                        AutomationProperties.AutomationId="StartupEditOkButton"
                        Content="OK"
                        Click="StartupEditOkButton_Click"
                        Command="{Binding OkCommand}"
                        IsEnabled="{Binding IsValid}"
                        IsDefault="True"
                        MinWidth="90" Margin="0,0,8,0" Padding="6,4"/>
                <Button x:Name="StartupEditCancelButton"
                        AutomationProperties.AutomationId="StartupEditCancelButton"
                        Content="キャンセル"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        MinWidth="90" Padding="6,4"/>
            </StackPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <TextBlock x:Name="StartupEditStatusText"
                       AutomationProperties.AutomationId="StartupEditStatusText"
                       Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource Fg.Muted}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 中央：編集エリア -->
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="コマンド："
                       VerticalAlignment="Center" Margin="0,0,10,8"
                       FontSize="12"
                       Foreground="{DynamicResource Fg.Default}"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="StartupEditCommandBox"
                     AutomationProperties.AutomationId="StartupEditCommandBox"
                     Text="{Binding EditableCommand, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,0,8"
                     Padding="6,4" FontFamily="Consolas"/>

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="種別："
                       VerticalAlignment="Center" Margin="0,0,10,8"
                       FontSize="12"
                       Foreground="{DynamicResource Fg.Default}"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="StartupEditRegSzRadio"
                             AutomationProperties.AutomationId="StartupEditRegSzRadio"
                             GroupName="ValueKind"
                             Content="通常 (REG_SZ)"
                             IsChecked="{Binding IsRegSz, Mode=TwoWay}"
                             VerticalAlignment="Center" Margin="0,0,18,0"/>
                <RadioButton x:Name="StartupEditRegExpandSzRadio"
                             AutomationProperties.AutomationId="StartupEditRegExpandSzRadio"
                             GroupName="ValueKind"
                             Content="環境変数展開 (REG_EXPAND_SZ)"
                             IsChecked="{Binding IsRegExpandSz, Mode=TwoWay}"
                             VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,8,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource Fg.Subtle}"
                       TextWrapping="Wrap">
                <Run Text="ⓘ"/>
                <Run Text=" REG_EXPAND_SZ を選ぶと、%ProgramFiles% など環境変数を含むコマンドが起動時に展開されます。"/>
                <LineBreak/>
                <Run Text="  既存値の種別を変えると古い値が消えるため、通常は元の種別のまま保存してください。"/>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
