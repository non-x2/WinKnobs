<Window x:Class="WinKnobs.Views.Startup.StartupEntryEditDialog"
        x:Name="StartupEntryEditDialogRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinKnobs.ViewModels.Startup"
        xmlns:conv="clr-namespace:WinKnobs.Converters"
        d:DataContext="{d:DesignInstance Type=vm:StartupEntryEditViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="スタートアップエントリの編集"
        AutomationProperties.AutomationId="StartupEntryEditDialog"
        Height="400" Width="640"
        MinHeight="360" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Fg.Default}">

    <Window.Resources>
        <conv:BoolToCollapsedVisibilityConverter x:Key="BoolToCollapsed"/>
        <conv:BoolToVisibleVisibilityConverter x:Key="BoolToVisible"/>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="0">

        <!-- ヘッダ：エントリ名＋ハイブ（Edit / Add でアイコンとタイトル切替） -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <StackPanel>
                <!-- Edit モード時のヘッダ -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsNewMode, Converter={StaticResource BoolToCollapsed}}">
                    <TextBlock Text="🚀" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EntryNameText"
                               AutomationProperties.AutomationId="EntryNameText"
                               Text="{Binding DisplayName}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg.Default}"/>
                </StackPanel>
                <!-- Add モード時のヘッダ -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsNewMode, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="🆕" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="新規スタートアップエントリ"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg.Default}"/>
                </StackPanel>
                <TextBlock Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource Fg.Subtle}"
                           TextWrapping="Wrap">
                    <Run Text="ⓘ"/>
                    <Run Text=" 新規追加は HKCU\Run（自分のユーザーのみ）が安全です。HKLM 系を選ぶと管理者再起動が必要です。"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- フッタ：OK／キャンセル -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartupEditOkButton"
                        AutomationProperties.AutomationId="StartupEditOkButton"
                        Content="OK"
                        Click="StartupEditOkButton_Click"
                        Command="{Binding OkCommand}"
                        IsEnabled="{Binding IsValid}"
                        IsDefault="True"
                        MinWidth="90" Margin="0,0,8,0" Padding="6,4"/>
                <Button x:Name="StartupEditCancelButton"
                        AutomationProperties.AutomationId="StartupEditCancelButton"
                        Content="キャンセル"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        MinWidth="90" Padding="6,4"/>
            </StackPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <TextBlock x:Name="StartupEditStatusText"
                       AutomationProperties.AutomationId="StartupEditStatusText"
                       Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource Fg.Muted}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 中央：編集エリア -->
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- ハイブ -->
                <RowDefinition Height="Auto"/>  <!-- 名前 -->
                <RowDefinition Height="Auto"/>  <!-- コマンド -->
                <RowDefinition Height="Auto"/>  <!-- 種別 -->
                <RowDefinition Height="*"/>     <!-- 注記 -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ハイブ：Edit 時は読取専用 / Add 時は ComboBox -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="ハイブ："
                       VerticalAlignment="Center" Margin="0,0,10,8"
                       FontSize="12"
                       Foreground="{DynamicResource Fg.Default}"/>
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                <!-- Edit モード：HiveDisplay を読取専用 TextBlock で表示 -->
                <TextBlock Text="{Binding HiveDisplay}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource Fg.Muted}"
                           Visibility="{Binding IsNewMode, Converter={StaticResource BoolToCollapsed}}"/>
                <!-- Add モード：ComboBox で選択可 -->
                <ComboBox x:Name="StartupEditHiveCombo"
                          AutomationProperties.AutomationId="StartupEditHiveCombo"
                          ItemsSource="{Binding SelectableHives}"
                          SelectedItem="{Binding SelectedHive, Mode=TwoWay}"
                          Padding="6,3"
                          Visibility="{Binding IsNewMode, Converter={StaticResource BoolToVisible}}"/>
            </Grid>

            <!-- 名前：Edit 時は読取専用 / Add 時は TextBox -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="名前："
                       VerticalAlignment="Center" Margin="0,0,10,8"
                       FontSize="12"
                       Foreground="{DynamicResource Fg.Default}"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                <!-- Edit モード：名前を読取専用 TextBlock -->
                <TextBlock Text="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource Fg.Muted}"
                           Visibility="{Binding IsNewMode, Converter={StaticResource BoolToCollapsed}}"/>
                <!-- Add モード：TextBox で入力可 -->
                <TextBox x:Name="StartupEditNameBox"
                         AutomationProperties.AutomationId="StartupEditNameBox"
                         Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         Padding="6,4" FontFamily="Consolas"
                         MaxLength="255"
                         Visibility="{Binding IsNewMode, Converter={StaticResource BoolToVisible}}"/>
            </Grid>

            <!-- コマンド：常に編集可 -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="コマンド："
                       VerticalAlignment="Center" Margin="0,0,10,8"
                       FontSize="12"
                       Foreground="{DynamicResource Fg.Default}"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     x:Name="StartupEditCommandBox"
                     AutomationProperties.AutomationId="StartupEditCommandBox"
                     Text="{Binding EditableCommand, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,0,8"
                     Padding="6,4" FontFamily="Consolas"/>

            <!-- 種別：常に編集可 -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="種別："
                       VerticalAlignment="Center" Margin="0,0,10,8"
                       FontSize="12"
                       Foreground="{DynamicResource Fg.Default}"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="StartupEditRegSzRadio"
                             AutomationProperties.AutomationId="StartupEditRegSzRadio"
                             GroupName="ValueKind"
                             Content="通常 (REG_SZ)"
                             IsChecked="{Binding IsRegSz, Mode=TwoWay}"
                             VerticalAlignment="Center" Margin="0,0,18,0"/>
                <RadioButton x:Name="StartupEditRegExpandSzRadio"
                             AutomationProperties.AutomationId="StartupEditRegExpandSzRadio"
                             GroupName="ValueKind"
                             Content="環境変数展開 (REG_EXPAND_SZ)"
                             IsChecked="{Binding IsRegExpandSz, Mode=TwoWay}"
                             VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 注記 -->
            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,8,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource Fg.Subtle}"
                       TextWrapping="Wrap">
                <Run Text="ⓘ"/>
                <Run Text=" REG_EXPAND_SZ を選ぶと、%ProgramFiles% など環境変数を含むコマンドが起動時に展開されます。"/>
                <LineBreak/>
                <Run Text="  既存値の種別を変えると古い値が消えるため、通常は元の種別のまま保存してください。"/>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
