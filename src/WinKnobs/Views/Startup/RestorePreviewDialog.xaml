<Window x:Class="WinKnobs.Views.Startup.RestorePreviewDialog"
        x:Name="RestorePreviewDialogRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinKnobs.ViewModels.Startup"
        xmlns:conv="clr-namespace:WinKnobs.Converters"
        d:DataContext="{d:DesignInstance Type=vm:RestorePreviewViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="スナップショット復元プレビュー"
        AutomationProperties.AutomationId="RestorePreviewDialog"
        Height="520" Width="920"
        MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Fg.Default}">

    <Window.Resources>
        <conv:BoolToCollapsedVisibilityConverter x:Key="BoolToCollapsed"/>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="0">

        <!-- ヘッダ：ファイル名・作成日時・件数・注意書き -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='復元プレビュー（差分 {0} 件）'}"
                               AutomationProperties.AutomationId="RestorePreviewHeaderText"
                               FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Margin="26,4,0,0" Foreground="{DynamicResource Fg.Muted}"
                           Text="{Binding FileName, StringFormat='ファイル：{0}'}"/>
                <TextBlock Margin="26,0,0,0" Foreground="{DynamicResource Fg.Muted}"
                           Text="{Binding CreatedAtText, StringFormat='作成日時：{0}'}"/>
                <TextBlock Margin="26,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Muted}"
                           Text="※ 復元すると下記の通り、レジストリの全 6 Run キー + 3 StartupApproved キーが snapshot 時点の状態に上書きされます（HKLM 系は管理者権限が必要）。"/>
            </StackPanel>
        </Border>

        <!-- フッタ：確認チェック + ボタン -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <CheckBox Content="内容を確認しました"
                          IsChecked="{Binding IsConfirmed}"
                          AutomationProperties.AutomationId="RestorePreviewConfirmCheck"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="復元"
                            Command="{Binding OkCommand}"
                            IsEnabled="{Binding CanRestore}"
                            AutomationProperties.AutomationId="RestorePreviewOkButton"
                            MinWidth="92" Margin="0,0,8,0" Padding="10,4"/>
                    <Button Content="キャンセル"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            AutomationProperties.AutomationId="RestorePreviewCancelButton"
                            MinWidth="92" Padding="10,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 本体：3 ペイン（🗑削除 / ✏変更 / ➕追加） -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 削除予定（赤） -->
            <Border Grid.Column="0" Margin="0,0,6,0"
                    BorderBrush="#FFE57373" BorderThickness="1" CornerRadius="3">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Background="#33FF5252" Padding="8,5">
                        <TextBlock Text="{Binding RemovedCount, StringFormat='🗑 削除予定 ({0})'}"
                                   FontWeight="Bold"/>
                    </Border>
                    <Grid>
                        <DataGrid ItemsSource="{Binding RemovedEntries}"
                                  AutomationProperties.AutomationId="RestorePreviewRemovedList"
                                  AutoGenerateColumns="False" HeadersVisibility="None"
                                  IsReadOnly="True" Background="Transparent"
                                  GridLinesVisibility="None" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding}"/>
                                            <Setter Property="Margin" Value="4,2"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="（なし）" Foreground="{DynamicResource Fg.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasRemoved, Converter={StaticResource BoolToCollapsed}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 変更予定（黄） -->
            <Border Grid.Column="1" Margin="3,0,3,0"
                    BorderBrush="#FFFFD54F" BorderThickness="1" CornerRadius="3">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Background="#33FFD54F" Padding="8,5">
                        <TextBlock Text="{Binding ModifiedCount, StringFormat='✏ 変更予定 ({0})'}"
                                   FontWeight="Bold"/>
                    </Border>
                    <Grid>
                        <DataGrid ItemsSource="{Binding ModifiedEntries}"
                                  AutomationProperties.AutomationId="RestorePreviewModifiedList"
                                  AutoGenerateColumns="False" HeadersVisibility="None"
                                  IsReadOnly="True" Background="Transparent"
                                  GridLinesVisibility="None" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding}"/>
                                            <Setter Property="Margin" Value="4,2"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="（なし）" Foreground="{DynamicResource Fg.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasModified, Converter={StaticResource BoolToCollapsed}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 追加予定（緑） -->
            <Border Grid.Column="2" Margin="6,0,0,0"
                    BorderBrush="#FF81C784" BorderThickness="1" CornerRadius="3">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Background="#3366BB6A" Padding="8,5">
                        <TextBlock Text="{Binding AddedCount, StringFormat='➕ 追加予定 ({0})'}"
                                   FontWeight="Bold"/>
                    </Border>
                    <Grid>
                        <DataGrid ItemsSource="{Binding AddedEntries}"
                                  AutomationProperties.AutomationId="RestorePreviewAddedList"
                                  AutoGenerateColumns="False" HeadersVisibility="None"
                                  IsReadOnly="True" Background="Transparent"
                                  GridLinesVisibility="None" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding}"/>
                                            <Setter Property="Margin" Value="4,2"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="（なし）" Foreground="{DynamicResource Fg.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasAdded, Converter={StaticResource BoolToCollapsed}}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
