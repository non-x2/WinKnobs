<Window x:Class="WinKnobs.Views.RemoteDesktopEnableDialog"
        x:Name="RemoteDesktopEnableDialogRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinKnobs.ViewModels"
        xmlns:conv="clr-namespace:WinKnobs.Converters"
        d:DataContext="{d:DesignInstance Type=vm:RemoteDesktopEnableViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="リモートデスクトップを有効にする（要管理者）"
        AutomationProperties.AutomationId="RemoteDesktopEnableDialog"
        Height="600" Width="640"
        MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Fg.Default}">

    <Window.Resources>
        <conv:BoolToVisibleVisibilityConverter x:Key="BoolToVisible"/>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="0">

        <!-- ヘッダ：🔴 危険度バッジ＋赤系配色（一目で「重い操作」と分かる） -->
        <Border DockPanel.Dock="Top"
                Background="#33FF5252"
                BorderBrush="#FFE57373"
                BorderThickness="0,0,0,2"
                Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔴" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding HeaderText}"
                               AutomationProperties.AutomationId="RemoteDesktopEnableHeaderText"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Border Background="#FFD32F2F" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="危険度：高" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Margin="28,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Text="{Binding WhatHappensText}"/>
            </StackPanel>
        </Border>

        <!-- フッタ：明示同意チェック + ボタン（既定フォーカス＝キャンセル） -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel>
                <CheckBox x:Name="CheckUnderstandRisk"
                          Content="リスクを理解しました"
                          IsChecked="{Binding IsRiskUnderstood}"
                          AutomationProperties.AutomationId="CheckUnderstandRisk"
                          FontWeight="Bold"
                          Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 有効化：チェック ON で初めて活性。IsDefault は付けない（Enter 連打での誤確定を防ぐ） -->
                    <Button x:Name="BtnEnable"
                            Content="有効化"
                            Command="{Binding EnableCommand}"
                            IsEnabled="{Binding CanEnable}"
                            AutomationProperties.AutomationId="BtnEnable"
                            MinWidth="100" Margin="0,0,8,0" Padding="10,5"/>
                    <!-- キャンセル：既定フォーカス（誤確定防止）。Esc でも閉じる -->
                    <Button x:Name="BtnCancel"
                            Content="キャンセル"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            AutomationProperties.AutomationId="BtnCancel"
                            MinWidth="100" Padding="10,5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 本体：現在のコンテキスト＋推奨対策＋戻し方（スクロール可） -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>

                <!-- 現在のコンテキスト（ReadStatus 由来） -->
                <TextBlock Text="現在の状態" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="3" Padding="10,8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentStateText}" TextWrapping="Wrap" Margin="0,1"/>
                        <TextBlock Text="{Binding UserNameText}" TextWrapping="Wrap" Margin="0,1"/>
                        <TextBlock Text="{Binding LanIpText}" TextWrapping="Wrap" Margin="0,1"/>
                        <TextBlock Text="{Binding PortText}" TextWrapping="Wrap" Margin="0,1"
                                   AutomationProperties.AutomationId="RemoteDesktopEnablePortText"/>
                    </StackPanel>
                </Border>

                <!-- リモート接続中の警告（該当時のみ） -->
                <Border Background="#33FFD54F" BorderBrush="#FFFFB300" BorderThickness="1"
                        CornerRadius="3" Padding="10,8" Margin="0,0,0,12"
                        Visibility="{Binding IsCurrentSessionRemote, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{Binding RemoteSessionWarningText}" TextWrapping="Wrap"/>
                </Border>

                <!-- 推奨対策 -->
                <TextBlock Text="推奨対策" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="3" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock Text="{Binding RecommendationText}" TextWrapping="Wrap"/>
                </Border>

                <!-- 組織ポリシー注記（該当時のみ） -->
                <Border Background="#22888888" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="3" Padding="10,8" Margin="0,0,0,12"
                        Visibility="{Binding IsPolicyManaged, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{Binding PolicyNoteText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Muted}"/>
                </Border>

                <!-- 戻し方の保証 -->
                <Border Background="#3366BB6A" BorderBrush="#FF81C784" BorderThickness="1"
                        CornerRadius="3" Padding="10,8">
                    <TextBlock Text="{Binding RestoreAssuranceText}" TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
