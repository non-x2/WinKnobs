<UserControl x:Class="WinKnobs.Views.Graphics.GraphicsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKnobs.ViewModels.Graphics"
             d:DataContext="{d:DesignInstance Type=vm:GraphicsListViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Bg.Window}"
             Foreground="{DynamicResource Fg.Default}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,12">

            <!-- 説明 -->
            <Border Padding="10,8" Margin="0,0,0,12"
                    Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="🎨 グラフィック設定" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="アプリごとに使う GPU（内蔵 / 外付け）を選べます。管理者権限は不要です。変更は対象アプリを次に起動したときに反映されます。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Subtle}"/>
                </StackPanel>
            </Border>

            <!-- ━━ 全体の設定（既定の設定）━━ -->
            <TextBlock Text="━━ 全体の設定（既定の設定）━━" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Margin="0,0,0,6">
                <CheckBox AutomationProperties.AutomationId="ToggleSwapEffectGlobal"
                          IsChecked="{Binding SwapEffectGlobal}"
                          Content="ウィンドウゲームの最適化（全体）"
                          Margin="0,2"/>
                <CheckBox AutomationProperties.AutomationId="ToggleAutoHdrGlobal"
                          IsChecked="{Binding AutoHdrGlobal}"
                          Content="Auto HDR（全体）"
                          Margin="0,2"/>
                <TextBlock Text="※ Auto HDR は HDR 対応ディスプレイでのみ効果があります（非対応の場合、ON にしても見た目は変わりません）。"
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Fg.Subtle}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button AutomationProperties.AutomationId="OpenWindowsGraphicsButton"
                    Command="{Binding OpenWindowsGraphicsCommand}"
                    HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,12" Padding="8,5"
                    HorizontalContentAlignment="Left"
                    Content="🪟 Windows のグラフィック設定を開く"/>

            <!-- ━━ アプリ別GPU設定 ━━ -->
            <TextBlock Text="━━ アプリ別GPU設定 ━━" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Padding="0" Margin="0,0,0,6"
                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4">
                <ItemsControl AutomationProperties.AutomationId="GpuAppList"
                              ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1"
                                    AutomationProperties.AutomationId="{Binding DisplayName, StringFormat=GpuApp_{0}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FullPath}" FontSize="10"
                                                   Foreground="{DynamicResource Fg.Subtle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="190" Margin="0,0,8,0"
                                              ItemsSource="{Binding GpuChoices}"
                                              SelectedIndex="{Binding SelectedGpuIndex}"/>
                                    <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                              IsChecked="{Binding AutoHdr}"
                                              Content="Auto HDR"/>
                                    <Button Grid.Column="3" VerticalAlignment="Center"
                                            Content="🗑 リセット" Padding="6,3"
                                            Command="{Binding DataContext.ResetAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="（一覧が空のときは「アプリを追加」で .exe を選んで登録できます。GPU を選ぶと設定が書き込まれます。）"
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource Fg.Subtle}" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,12">
                <Button AutomationProperties.AutomationId="AddGpuAppButton"
                        Command="{Binding AddAppCommand}"
                        Content="➕ アプリを追加…" MinWidth="160" Margin="0,0,6,0" Padding="8,5"/>
                <Button AutomationProperties.AutomationId="RestoreGraphicsButton"
                        Command="{Binding RestoreAllCommand}"
                        Content="↩ グラフィック設定をぜんぶ元に戻す" MinWidth="240" Padding="8,5"/>
            </WrapPanel>

            <!-- ステータス -->
            <Border Margin="0,8,0,0" Padding="8,5"
                    Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="GraphicsStatusText"
                           AutomationProperties.AutomationId="GraphicsStatusText"
                           Text="{Binding StatusMessage}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg.Subtle}"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
